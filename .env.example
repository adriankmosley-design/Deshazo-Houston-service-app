# Copy this file to .env.local and fill in the two values from
# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: lets each job find its Outlook emails. The Application (client) ID
# of the "Job Files" app registration in Microsoft Entra.
VITE_MS_CLIENT_ID=
